# ==============================================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE E CREDENCIAIS (HIGIENIZADO)
# Copie este arquivo para .env e preencha os placeholders antes da execução.
# ==============================================================================

# 1. Infraestrutura AWS e Registro de Imagens ECR
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=<AWS_ACCOUNT_ID>
ECR_REGISTRY=<AWS_ACCOUNT_ID>.dkr.ecr.us-east-2.amazonaws.com

# 2. Endereçamento do Cluster K3s (Alvo do Injetor k6 e Coleta PromQL)
TARGET_IP=<EC2_K3S_PRIVATE_OR_PUBLIC_IP>
BASE_URL=https://blackcat.mugiwarasgroup.com.br

# 3. Credenciais do Banco de Dados MySQL 8.4
MYSQL_DATABASE=blackcat
MYSQL_USER=blackcat
MYSQL_PASSWORD=<DB_PASSWORD>
MYSQL_ROOT_PASSWORD=<DB_ROOT_PASSWORD>

# 4. Credenciais do Usuário Administrador de Teste (Seed Liquibase 002)
ADMIN_USER=sre_admin_tcc
ADMIN_PASS=<ADMIN_PASSWORD>
INITIAL_ADMIN_PASSWORD_HASH=<BCRYPT_HASH_OF_ADMIN_PASSWORD>

# 5. Integração Opcional com Grafana Cloud (Remote Write Prometheus)
GRAFANA_CLOUD_USER=<GRAFANA_CLOUD_USER_ID>
GRAFANA_CLOUD_API_KEY=<GRAFANA_CLOUD_API_TOKEN>
