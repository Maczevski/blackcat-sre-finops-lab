      "title": "SLI 1: Latência por Endpoint e Limiares de SLO (p50 / p95)",
      "description": "Latência típica (p50) e de cauda (p95) discriminada por rota (Catálogo, Login e Venda) confrontada com os limiares de SLO contratados.",
      "targets": [
        {
          "expr": "max(k6_http_req_duration_p95) or (histogram_quantile(0.95, sum(rate(http_req_duration_bucket[1m])) by (le)) / 1000)",
          "legendFormat": "Global p95",
          "refId": "A"
        },
        {
          "expr": "avg(k6_http_req_duration_p50) or (histogram_quantile(0.50, sum(rate(http_req_duration_bucket[1m])) by (le)) / 1000)",
          "legendFormat": "Global p50",
          "refId": "B"
        },
        {
          "expr": "max(k6_http_req_duration_p95{operation=\"catalogo_findAll\", expected_response=\"true\"}) or max(k6_op_catalogo_duration_p95) or (histogram_quantile(0.95, sum(rate(http_req_duration_bucket{operation=\"catalogo_findAll\"}[1m])) by (le)) / 1000)",
          "legendFormat": "Catálogo p95 (SLO <= 500ms)",
          "refId": "C"
        },
        {
          "expr": "max(k6_http_req_duration_p95{operation=\"auth_login\", expected_response=\"true\"}) or max(k6_op_login_duration_p95) or (histogram_quantile(0.95, sum(rate(http_req_duration_bucket{operation=\"auth_login\"}[1m])) by (le)) / 1000)",
          "legendFormat": "Login p95 (SLO <= 1.200ms)",
          "refId": "D"
        },
        {
          "expr": "max(k6_http_req_duration_p95{operation=\"venda_save\", expected_response=\"true\"}) or max(k6_op_venda_duration_p95) or (histogram_quantile(0.95, sum(rate(http_req_duration_bucket{operation=\"venda_save\"}[1m])) by (le)) / 1000)",
          "legendFormat": "Venda p95 (SLO <= 800ms)",
          "refId": "E"
        }
      ],
      "type": "timeseries"
    },
