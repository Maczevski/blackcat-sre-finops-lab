      "title": "SLI 2: Distribuição de Erros por Status HTTP",
      "description": "Discriminação temporal da taxa de erros HTTP segregada por status code e exceção, evidenciando o colapso por HTTP 500 no encerramento da janela.",
      "targets": [
        {
          "expr": "sum(rate(k6_http_reqs_total{status!~\"2..\"}[1m])) by (status) or sum(rate(http_reqs{status!~\"2..\"}[1m])) by (status)",
          "legendFormat": "Status HTTP {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"[45]..\"}[1m])) by (status, exception)",
          "legendFormat": "Backend HTTP {{status}} ({{exception}})",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    },
